{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "au-startup-map.vercel.app" }],
      "destination": "https://stillearly-au.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "au-startup-map.vercel.app" }],
      "destination": "https://stillearly-au.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/welcome", "destination": "/welcome/index.html" },
    { "source": "/welcome/", "destination": "/welcome/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/methodology", "destination": "/methodology/index.html" },
    { "source": "/methodology/", "destination": "/methodology/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    { "source": "/lists", "destination": "/lists/index.html" },
    { "source": "/lists/", "destination": "/lists/index.html" },
    { "source": "/lists/:path*", "destination": "/app.html" },
    { "source": "/investors", "destination": "/investors/index.html" },
    { "source": "/investors/", "destination": "/investors/index.html" },
    { "source": "/investors/:path*", "destination": "/app.html" },
    { "source": "/startup/:path*", "destination": "/app.html" },
    { "source": "/jobs", "destination": "/app.html" },
    { "source": "/news", "destination": "/app.html" },
    { "source": "/people", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
    }
  ]
}
