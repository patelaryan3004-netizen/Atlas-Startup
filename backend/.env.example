# Copy to backend/.env (git ignores that file) and fill in. Used by npm run db:status, db:migrate and founding:import (docs/database.md).
# The direct Neon address (Connection pooling OFF in the Connect dialog). It holds the password: never commit it, paste it into chat, or put it in the frontend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
